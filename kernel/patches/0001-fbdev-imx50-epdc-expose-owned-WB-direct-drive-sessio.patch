 drivers/video/fbdev/imx50-epdc.c        | 407 +++++++++++++++++++++++-
 include/linux/imx50-epdc-buffer.h       |   9 +
 include/uapi/linux/k4-epdc-wb.h         |  27 ++
 porting/epdc-multi-lut-stub.h           |  50 +++
 porting/test-epdc-pipeline.py           | 128 +++++++-
 porting/test-epdc-waveform.py           |   1 -
 project/docs/DISPLAY.md                 |  25 ++
