@@ -48,6 +55,7 @@ int imx50_epdc_hw_submit(struct imx50_epdc_hw *hw,
 void imx50_epdc_hw_events(struct imx50_epdc_hw *hw, struct imx50_epdc_events *events);
 /* Stock fls(active) selection; fallback to STATUS_NEXTLUT when LUT15 is active. */
 int imx50_epdc_hw_next_lut(struct imx50_epdc_hw *hw, bool *sync_eof);
+void imx50_epdc_hw_wb_session(struct imx50_epdc_hw *hw, bool enable);
 void imx50_epdc_hw_request_eof(struct imx50_epdc_hw *hw, bool enable);
 void imx50_epdc_hw_fault(struct imx50_epdc_hw *hw, int error);
 irqreturn_t imx50_epdc_hw_irq(int irq, void *data);
