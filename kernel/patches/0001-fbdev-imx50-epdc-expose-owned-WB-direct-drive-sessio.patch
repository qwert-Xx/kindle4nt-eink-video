+	if (cmd == K4_EPDC_WB_START) {
+		ret = epdc_wb_start(e, file, &info);
+		if (!ret && copy_to_user((void __user *)arg, &info, sizeof(info))) {
+			epdc_wb_stop(e);
+			ret = -EFAULT;
+		}
+	} else {
+		ret = READ_ONCE(e->wb_owner) && READ_ONCE(e->wb_owner) != file ?
+			-EBUSY : epdc_wb_stop(e);
+	}
+	mutex_unlock(&e->wb_lock);
+	return ret;
+}
+
+static int epdc_wb_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct imx50_epdc *e = file->private_data;
+	int ret;
+
+	mutex_lock(&e->lock);
+	if (e->wb_owner != file || !e->wb_active || e->wb_stopping || e->stopped) {
+		ret = -EINVAL;
+	} else {
+		ret = imx50_epdc_buffers_wb_mmap(e->buffers, vma);
+		if (!ret)
+			vma_set_file(vma, e->wb_mapping);
+	}
+	mutex_unlock(&e->lock);
+	return ret;
+}
