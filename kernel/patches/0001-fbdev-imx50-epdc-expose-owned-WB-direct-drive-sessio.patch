 	e->active_luts = 0;
 	e->initialized = false;
 	imx50_epdc_hw_fault(&e->hw, error);
+	wake_up_all(&e->hw.wb_wait);
 	if (e->buffers)
 		imx50_epdc_buffers_fault(e->buffers, error);
