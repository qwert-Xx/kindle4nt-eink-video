+static int epdc_wb_wait_frame(struct imx50_epdc *e, struct file *file,
+	struct k4_epdc_wb_frame *frame)
+{
+	unsigned long flags;
+	u32 boundary, epoch;
+	int ret;
+
+	mutex_lock(&e->lock);
+	if (e->wb_owner != file || e->wb_stopping) {
+		mutex_unlock(&e->lock);
+		return -EINVAL;
+	}
+	spin_lock_irqsave(&e->hw.irq_lock, flags);
+	epoch = e->wb_epoch;
+	boundary = e->hw.wb_boundary;
+	spin_unlock_irqrestore(&e->hw.irq_lock, flags);
+	mutex_unlock(&e->lock);
+	ret = wait_event_interruptible(e->hw.wb_wait,
+		READ_ONCE(e->fault) || !READ_ONCE(e->hw.wb_direct) ||
+		READ_ONCE(e->wb_stopping) || READ_ONCE(e->wb_epoch) != epoch ||
+		(READ_ONCE(e->hw.wb_ready) && READ_ONCE(e->hw.wb_boundary) != boundary));
+	if (ret)
+		return -EINTR;
+	mutex_lock(&e->lock);
+	ret = e->fault ?: (e->wb_owner != file || e->wb_stopping ||
+		e->wb_epoch != epoch ? -ECANCELED : 0);
+	if (!ret) {
+		spin_lock_irqsave(&e->hw.irq_lock, flags);
+		*frame = (struct k4_epdc_wb_frame) {
+			.frame = e->hw.wb_frame, .generation = e->hw.wb_generation,
+		};
+		spin_unlock_irqrestore(&e->hw.irq_lock, flags);
+	}
+	mutex_unlock(&e->lock);
+	return ret;
+}
+
+static void epdc_release(struct kref *ref)
+{
+	struct imx50_epdc *e = container_of(ref, struct imx50_epdc, refs);
+
+	kfree(e);
+}
+
+static void epdc_put(void *data)
+{
+	struct imx50_epdc *e = data;
+
+	kref_put(&e->refs, epdc_release);
+}
+
+static int epdc_wb_open(struct inode *inode, struct file *file)
+{
+	struct imx50_epdc *e = container_of(file->private_data, struct imx50_epdc, wb_misc);
+	int ret = 0;
+
+	mutex_lock(&e->lock);
+	if (e->stopped)
+		ret = -ENODEV;
+	else {
+		kref_get(&e->refs);
+		file->private_data = e;
+	}
+	mutex_unlock(&e->lock);
+	return ret;
+}
+
+static int epdc_wb_close(struct inode *inode, struct file *file)
+{
+	struct imx50_epdc *e = file->private_data;
+
+	mutex_lock(&e->wb_lock);
+	if (READ_ONCE(e->wb_owner) == file)
+		epdc_wb_stop(e);
+	mutex_unlock(&e->wb_lock);
+	epdc_put(e);
+	return 0;
+}
+
+static long epdc_wb_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct imx50_epdc *e = file->private_data;
+	struct k4_epdc_wb_info info;
+	struct k4_epdc_wb_frame frame;
+	int ret;
+
+	if (cmd == K4_EPDC_WB_WAIT_FRAME) {
+		ret = epdc_wb_wait_frame(e, file, &frame);
+		if (ret)
+			return ret;
+		return copy_to_user((void __user *)arg, &frame, sizeof(frame)) ? -EFAULT : 0;
+	}
+	if (cmd != K4_EPDC_WB_START && cmd != K4_EPDC_WB_STOP)
+		return -ENOTTY;
+	mutex_lock(&e->wb_lock);
+	if (cmd == K4_EPDC_WB_START) {
+		ret = epdc_wb_start(e, file, &info);
+		if (!ret && copy_to_user((void __user *)arg, &info, sizeof(info))) {
+			epdc_wb_stop(e);
+			ret = -EFAULT;
+		}
+	} else {
+		ret = READ_ONCE(e->wb_owner) && READ_ONCE(e->wb_owner) != file ?
+			-EBUSY : epdc_wb_stop(e);
+	}
+	mutex_unlock(&e->wb_lock);
+	return ret;
+}
+
+static int epdc_wb_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct imx50_epdc *e = file->private_data;
+	int ret;
+
+	mutex_lock(&e->lock);
+	if (e->wb_owner != file || !e->wb_active || e->wb_stopping || e->stopped) {
+		ret = -EINVAL;
+	} else {
+		ret = imx50_epdc_buffers_wb_mmap(e->buffers, vma);
+		if (!ret)
+			vma_set_file(vma, e->wb_mapping);
+	}
+	mutex_unlock(&e->lock);
+	return ret;
+}
