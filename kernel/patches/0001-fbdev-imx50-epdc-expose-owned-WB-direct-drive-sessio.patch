+
+struct k4_epdc_wb_frame {
+	__aligned_u64 frame;
+	__u32 generation, reserved;
+};
+
+/* WAIT_FRAME input: the last returned frame and generation; initialize both
+ * to zero after every successful START. Output: current cumulative frame and
+ * generation. Once WB processing is ready, return immediately if frame has
+ * advanced or generation differs; otherwise wait for progress. Signal returns
+ * EINTR; a session stopped/replaced while waiting returns ECANCELED (or its
+ * hardware error). A cursor belongs to one START and must not be reused.
+ */
+#define K4_EPDC_WB_START _IOR(0xB8, 0, struct k4_epdc_wb_info)
+#define K4_EPDC_WB_WAIT_FRAME _IOWR(0xB8, 1, struct k4_epdc_wb_frame)
+#define K4_EPDC_WB_STOP _IO(0xB8, 2)
+
+/* mmap offset zero, length info.size (rounded to pages by mmap).
+ * STOP revokes mappings: subsequent access raises SIGBUS. Close the last
+ * device fd to stop; mappings do not retain that fd's session ownership.
+ */
+#endif
