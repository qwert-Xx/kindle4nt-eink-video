+/* Compare the caller's cursor under irq_lock: u64 frame reads can tear on ARM.
+ * A caught-up caller sleeps; a late caller consumes already-recorded EOFs.
+ */
+static bool epdc_wb_frame_available(struct imx50_epdc *e,
+	const struct k4_epdc_wb_frame *cursor, u32 epoch)
+{
+	unsigned long flags;
+	bool ready;
+
+	spin_lock_irqsave(&e->hw.irq_lock, flags);
+	ready = READ_ONCE(e->fault) || !e->hw.wb_direct ||
+		READ_ONCE(e->wb_stopping) || READ_ONCE(e->wb_epoch) != epoch ||
+		(e->hw.wb_ready && (e->hw.wb_frame > cursor->frame ||
+				   e->hw.wb_generation != cursor->generation));
+	spin_unlock_irqrestore(&e->hw.irq_lock, flags);
+	return ready;
+}
+
+/* The wait path takes only the IRQ lock: the real-time caller must not block
+ * behind the owner mutex, which a normal-priority worker may hold.
+ */
+static int epdc_wb_wait_frame(struct imx50_epdc *e, struct file *file,
+	struct k4_epdc_wb_frame *frame)
+{
+	unsigned long flags;
+	u32 epoch;
+	int ret;
+
+	if (READ_ONCE(e->wb_owner) != file || READ_ONCE(e->wb_stopping))
+		return -EINVAL;
+	epoch = READ_ONCE(e->wb_epoch);
+	for (;;) {
+		ret = wait_event_interruptible(e->hw.wb_wait,
+					      epdc_wb_frame_available(e, frame, epoch));
+		if (ret)
+			return -EINTR;
+		spin_lock_irqsave(&e->hw.irq_lock, flags);
+		ret = READ_ONCE(e->fault) ?: (READ_ONCE(e->wb_owner) != file ||
+			READ_ONCE(e->wb_stopping) || READ_ONCE(e->wb_epoch) != epoch ?
+			-ECANCELED : 0);
+		/* A restart between the wake and this check is exposed only after
+		 * its WB processing, so userspace resync writes are not overwritten.
+		 */
+		if (!ret && e->hw.wb_ready && (e->hw.wb_frame > frame->frame ||
+					      e->hw.wb_generation != frame->generation)) {
+			*frame = (struct k4_epdc_wb_frame) {
+				.frame = e->hw.wb_frame, .generation = e->hw.wb_generation,
+			};
+			spin_unlock_irqrestore(&e->hw.irq_lock, flags);
+			return 0;
+		}
+		spin_unlock_irqrestore(&e->hw.irq_lock, flags);
+		if (ret)
+			return ret;
+	}
+}
+
+static void epdc_release(struct kref *ref)
+{
+	struct imx50_epdc *e = container_of(ref, struct imx50_epdc, refs);
+
+	kfree(e);
+}
+
+static void epdc_put(void *data)
+{
+	struct imx50_epdc *e = data;
+
+	kref_put(&e->refs, epdc_release);
+}
+
+static int epdc_wb_open(struct inode *inode, struct file *file)
+{
+	struct imx50_epdc *e = container_of(file->private_data, struct imx50_epdc, wb_misc);
+	int ret = 0;
+
+	mutex_lock(&e->lock);
+	if (e->stopped)
+		ret = -ENODEV;
+	else {
+		kref_get(&e->refs);
+		file->private_data = e;
+	}
+	mutex_unlock(&e->lock);
+	return ret;
+}
+
+static int epdc_wb_close(struct inode *inode, struct file *file)
+{
+	struct imx50_epdc *e = file->private_data;
+
+	mutex_lock(&e->wb_lock);
+	if (READ_ONCE(e->wb_owner) == file)
+		epdc_wb_stop(e);
+	mutex_unlock(&e->wb_lock);
+	epdc_put(e);
+	return 0;
+}
+
+static long epdc_wb_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct imx50_epdc *e = file->private_data;
+	struct k4_epdc_wb_info info;
+	struct k4_epdc_wb_frame frame;
+	int ret;
+
+	if (cmd == K4_EPDC_WB_WAIT_FRAME) {
+		if (copy_from_user(&frame, (void __user *)arg, sizeof(frame)))
+			return -EFAULT;
+		ret = epdc_wb_wait_frame(e, file, &frame);
+		if (ret)
+			return ret;
+		return copy_to_user((void __user *)arg, &frame, sizeof(frame)) ? -EFAULT : 0;
+	}
