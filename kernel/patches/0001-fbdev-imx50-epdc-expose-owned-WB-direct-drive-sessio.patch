+	e->powerdown_delay = IMX50_EPDC_POWERDOWN_DISABLE;
+	e->queue_error = 0;
+	cancel_delayed_work(&e->done_work);
+	epdc_notify(e);
+	mutex_unlock(&e->lock);
+	waited = wait_event_interruptible_timeout(e->hw.wb_wait, epdc_wb_started(e),
+						msecs_to_jiffies(e->timeout_ms));
+	mutex_lock(&e->lock);
+	ret = e->fault ?: e->queue_error;
+	if (!ret && (e->stopped || e->suspended))
+		ret = -EBUSY;
+	if (!ret && waited <= 0)
+		ret = waited < 0 ? -EINTR : -ETIMEDOUT;
+	if (!ret)
+		*info = e->wb_info;
+	mutex_unlock(&e->lock);
+	if (ret)
+		epdc_wb_stop(e);
+	return ret;
+}
