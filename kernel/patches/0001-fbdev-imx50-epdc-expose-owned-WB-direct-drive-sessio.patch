diff --git a/drivers/video/fbdev/imx50-epdc-buffer.c b/drivers/video/fbdev/imx50-epdc-buffer.c
index 91ac55e..d5cc741 100644
--- a/drivers/video/fbdev/imx50-epdc-buffer.c
+++ b/drivers/video/fbdev/imx50-epdc-buffer.c
@@ -6,6 +6,9 @@
 #include <linux/imx50-epdc-buffer.h>
 #include <linux/imx50-epdc-image.h>
 #include <linux/module.h>
+#include <linux/mm.h>
+#include <uapi/linux/k4-epdc-wb.h>
+#include <asm/unaligned.h>
 #include <linux/overflow.h>
 #include <linux/slab.h>
 
@@ -96,7 +99,8 @@ struct imx50_epdc_buffers *imx50_epdc_buffers_alloc(struct device *dev,
 	    !width || !height || width > EPDC_RES_MAX || height > EPDC_RES_MAX || (width & 3) ||
 	    !modes || modes > 256 || !temperatures || temperatures > 256)
 		return ERR_PTR(-EINVAL);
-	if (check_mul_overflow((size_t)width * 2, (size_t)height, &work_bytes) ||
+	if (check_mul_overflow((size_t)ALIGN(width, 4) * sizeof(u16),
+			       (size_t)height, &work_bytes) ||
 	    check_mul_overflow((size_t)ALIGN(width, 8), (size_t)height, &update_bytes))
 		return ERR_PTR(-EOVERFLOW);
 	b = kzalloc(sizeof(*b), GFP_KERNEL);
@@ -298,6 +302,90 @@ int imx50_epdc_buffers_invalidate(struct imx50_epdc_buffers *b)
 	return 0;
 }
 
+int imx50_epdc_buffers_wb_actions(struct imx50_epdc_buffers *b, u32 mode,
+	u32 temperature, u8 *black, u8 *white, u32 *push_frames)
+{
+	const u8 *wave = b->wave.cpu + EPDC_GUARD;
+	u64 offset, frames;
+	unsigned int i;
+
+	if (mode >= b->modes || temperature >= b->temperatures ||
+	    (u64)b->modes * 8 > b->wave.bytes)
+		return -EINVAL;
+	offset = get_unaligned_le64(wave + mode * 8);
+	if (offset > b->wave.bytes || (u64)b->temperatures * 8 > b->wave.bytes - offset)
+		return -EBADMSG;
+	offset = get_unaligned_le64(wave + offset + temperature * 8);
+	if (offset > b->wave.bytes || b->wave.bytes - offset < 8)
+		return -EBADMSG;
+	frames = get_unaligned_le64(wave + offset);
+	if (!frames || frames > (b->wave.bytes - offset - 8) / 256)
+		return -EBADMSG;
+	*black = *white = 0;
+	*push_frames = 0;
+	for (i = 0; i < frames; i++) {
+		const u8 *action = wave + offset + 8 + i * 256;
+
+		if (!*black)
+			*black = action[0x0f];
+		if (!*white)
+			*white = action[0xf0];
+		*push_frames += !!action[0xf0];
+	}
+	return *black && *white ? 0 : -ENODATA;
+}
+
+void imx50_epdc_buffers_wb_info(struct imx50_epdc_buffers *b,
+	struct k4_epdc_wb_info *info)
+{
+	/* RM 24.3.8.1: WB scan pitch is roundup4(horizontal) 16-bit pixels. */
+	*info = (struct k4_epdc_wb_info) {
+		.width = b->width, .height = b->height,
+		.stride = ALIGN(b->width, 4), .size = b->work.bytes,
+		.hold = IMX50_EPDC_WB_PIXEL(IMX50_EPDC_WB_HOLD_COLOR),
+		.black = IMX50_EPDC_WB_PIXEL(0), .white = IMX50_EPDC_WB_PIXEL(15),
+		.frames_per_lut = IMX50_EPDC_WB_FRAMES,
+	};
+}
+
+void imx50_epdc_buffers_wb_command(struct imx50_epdc_buffers *b,
+	u32 waveform_addr, struct imx50_epdc_command *c)
+{
+	u32 fixed_gray = IMX50_EPDC_WB_HOLD_COLOR * 0x11;
+
+	/* RM 24.4.10/11: USE_FIXED, FIXCP/NP in Y8, FULL and the session LUT.
+	 * Both colors are fixed so previous WB targets cannot affect startup.
+	 */
+	*c = (struct imx50_epdc_command) {
+		.waveform_addr = waveform_addr,
+		.working_addr = b->work.dma + EPDC_GUARD,
+		.resolution = b->width | (b->height << 16),
+		.size = b->width | (b->height << 16),
+		.fixed = BIT(31) | BIT(30) | (fixed_gray << 8) | fixed_gray,
+		.control = BIT(31) | (IMX50_EPDC_WB_LUT << 16) | (1 << 8) | 1,
+	};
+}
+
+int imx50_epdc_buffers_wb_mmap(struct imx50_epdc_buffers *b,
+	struct vm_area_struct *vma)
+{
+	/* Guards are outside the exposed payload; the page tail stays owned. */
+	if (vma->vm_pgoff || vma->vm_end - vma->vm_start != PAGE_ALIGN(b->work.bytes))
+		return -EINVAL;
+	return dma_mmap_coherent(b->dev, vma, b->work.cpu + EPDC_GUARD,
+				 b->work.dma + EPDC_GUARD, PAGE_ALIGN(b->work.bytes));
+}
+
+void imx50_epdc_buffers_wb_hold(struct imx50_epdc_buffers *b)
+{
+	u16 *work = (u16 *)(b->work.cpu + EPDC_GUARD);
+	size_t i;
+
+	for (i = 0; i < b->work.bytes / 2; i++)
+		WRITE_ONCE(work[i], IMX50_EPDC_WB_PIXEL(IMX50_EPDC_WB_HOLD_COLOR));
+	dma_wmb();
+}
+
 int imx50_epdc_buffers_free(struct imx50_epdc_buffers *b)
 {
 	unsigned int i;
diff --git a/drivers/video/fbdev/imx50-epdc-hw.c b/drivers/video/fbdev/imx50-epdc-hw.c
index 3f79150..f25c6b0 100644
--- a/drivers/video/fbdev/imx50-epdc-hw.c
+++ b/drivers/video/fbdev/imx50-epdc-hw.c
@@ -71,6 +71,7 @@ void imx50_epdc_hw_init(struct imx50_epdc_hw *hw, void __iomem *base)
 	*hw = (struct imx50_epdc_hw){ .base = base };
 	mutex_init(&hw->lock);
 	spin_lock_init(&hw->irq_lock);
+	init_waitqueue_head(&hw->wb_wait);
 
 }
 
@@ -230,6 +231,21 @@ irqreturn_t imx50_epdc_hw_irq(int irq, void *data)
 		hw->events.wb = true;
 	if (pending & E_EOF)
 		hw->events.eof = true;
+	if (hw->wb_direct) {
+		/* Count scan boundaries directly: sampling DEBUG_LUTn's remaining
+		 * frames races its decrement against EOF and can repeat or skip one.
+		 * Frames scanned before WB processing completes drive no pixels.
+		 */
+		if (hw->wb_live && hw->wb_ready && (pending & E_EOF))
+			hw->wb_frame++;
+		if (hw->wb_live && (pending & BIT(IMX50_EPDC_WB_LUT))) {
+			hw->wb_completed = hw->wb_frame;
+			hw->wb_live = false;
+		}
+		if (pending & E_WB)
+			hw->wb_ready = true;
+		wake_up_all(&hw->wb_wait);
+	}
 	if (pending & E_UNDERRUN)
 		pr_warn_ratelimited("imx50-epdc: TCE underrun\n");
 	if (pending & E_BUS_ERROR) {
@@ -238,7 +254,9 @@ irqreturn_t imx50_epdc_hw_irq(int irq, void *data)
 	} else {
 		u32 mask = readl(hw->base + E_MASK);
 
-		mask &= ~(pending & (0xffff | E_EOF | E_WB | E_COLLISION));
+		mask &= ~(pending & (0xffff | E_WB | E_COLLISION));
+		if (!hw->wb_direct)
+			mask &= ~(pending & E_EOF);
 		writel(mask, hw->base + E_MASK);
 	}
 	writel(pending, hw->base + E_IRQ_CLR);
@@ -247,7 +265,10 @@ irqreturn_t imx50_epdc_hw_irq(int irq, void *data)
 		hw->running = false;
 		hw->events.idle = true;
 	}
-	if (hw->notify)
+	/* A WB session's per-frame EOF only advances the frame count above; the
+	 * owner worker is needed for LUT completion, WB processing and faults.
+	 */
+	if (hw->notify && (!hw->wb_direct || (pending & ~E_EOF)))
 		hw->notify(hw->notify_data);
 out:
 	spin_unlock_irqrestore(&hw->irq_lock, flags);
@@ -329,6 +350,22 @@ int imx50_epdc_hw_next_lut(struct imx50_epdc_hw *hw, bool *sync_eof)
 	return lut;
 }
 
+void imx50_epdc_hw_wb_session(struct imx50_epdc_hw *hw, bool enable)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hw->irq_lock, flags);
+	hw->wb_direct = enable;
+	if (enable) {
+		hw->wb_frame = hw->wb_completed = 0;
+		hw->wb_restarted = false;
+		hw->wb_generation = 0;
+		hw->wb_live = hw->wb_ready = false;
+	}
+	wake_up_all(&hw->wb_wait);
+	spin_unlock_irqrestore(&hw->irq_lock, flags);
+}
+
 void imx50_epdc_hw_request_eof(struct imx50_epdc_hw *hw, bool enable)
 {
 	unsigned long flags;
@@ -367,6 +404,13 @@ int imx50_epdc_hw_submit(struct imx50_epdc_hw *hw,
 	writel(c->temperature, hw->base + E_TEMP);
 	writel(readl(hw->base + E_MASK) | E_WB | E_COLLISION | E_UNDERRUN |
 	       E_BUS_ERROR | E_IDLE | BIT(lut), hw->base + E_MASK);
+	if (hw->wb_direct) {
+		if (hw->wb_restarted)
+			hw->wb_generation++;
+		hw->wb_restarted = true;
+		hw->wb_live = true;
+		hw->wb_ready = false;
+	}
 	hw->running = true;
 	hw->drained = false;
 	writel(c->control, hw->base + E_COMMAND);
