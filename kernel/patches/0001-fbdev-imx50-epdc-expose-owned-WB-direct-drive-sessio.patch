+#include <asm/unaligned.h>
 #include <linux/clk.h>
 #include <linux/dma-mapping.h>
 #include <linux/gpio/consumer.h>
@@ -48,6 +57,18 @@ struct epdc_update {
 
 struct imx50_epdc {
 	struct device *dev, *papyrus;
+	struct kref refs;
+	struct miscdevice wb_misc;
+	struct mutex wb_lock; /* Serializes session START/STOP, outside owner lock. */
+	struct file *wb_owner, *wb_mapping;
+	void *wb_wave;
+	dma_addr_t wb_wave_dma;
+	struct k4_epdc_wb_info wb_info;
+	struct imx50_epdc_command wb_command;
+	bool wb_active, wb_stopping, wb_processing;
+	int wb_saved_delay;
+	unsigned long wb_deadline;
+	u32 wb_epoch;
 	struct mutex lock;
 	struct imx50_epdc_hw hw;
 	struct imx50_pxp *pxp;
@@ -345,6 +366,7 @@ static void epdc_fail_queue(struct imx50_epdc *e, int error)
 	e->active_luts = 0;
 	e->initialized = false;
 	imx50_epdc_hw_fault(&e->hw, error);
+	wake_up_all(&e->hw.wb_wait);
 	if (e->buffers)
 		imx50_epdc_buffers_fault(e->buffers, error);
 	/* WB descriptor also occupies a LUT; retire it only through that LUT. */
@@ -457,13 +479,65 @@ static struct epdc_update *epdc_select(struct imx50_epdc *e)
 	return selected;
 }
 
+static int epdc_wb_submit(struct imx50_epdc *e)
+{
+	int ret;
+
+	ret = imx50_epdc_hw_submit(&e->hw, &e->wb_command);
+	if (!ret) {
+		e->wb_processing = true;
+		e->wb_deadline = e->drain_deadline = jiffies + msecs_to_jiffies(e->timeout_ms);
+	}
+	return ret;
+}
+
+static int epdc_wb_prepare(struct imx50_epdc *e)
+{
+	u8 black, white, *table = e->wb_wave;
+	u32 pushes;
+	int mode, temperature, ret;
+	unsigned int f, i;
+
+	mode = imx50_epdc_waveform_mode(e->wave, IMX50_EPDC_A2);
+	if (mode < 0)
+		return mode;
+	temperature = epdc_temperature(e);
+	if (temperature < 0)
+		return temperature;
+	ret = imx50_epdc_buffers_wb_actions(e->buffers, mode, temperature,
+					  &black, &white, &pushes);
+	if (ret)
+		return ret;
+	/* A private mode/temp table leaves the firmware payload untouched.
+	 * RM 24.3.8.1/4: every scan fetches the current 256-action frame.
+	 */
+	put_unaligned_le64(16, table);
+	put_unaligned_le64(16, table + 8);
+	put_unaligned_le64(24, table + 16);
+	put_unaligned_le64(1023, table + 24);
+	for (f = 0; f < 1023; f++)
+		for (i = 0; i < 256; i++)
+			table[32 + f * 256 + i] = i >> 4 == 0 ? black : i >> 4 == 15 ? white : 0;
+	e->wb_info = (struct k4_epdc_wb_info) {
+		.width = 800, .height = 600, .stride = 800, .size = 800 * 600 * 2,
+		.hold = 0x0088, .black = 0x0008, .white = 0x00f8,
+		.frames_per_lut = 1023, .push_frames = pushes,
+	};
+	imx50_epdc_buffers_wb_command(e->buffers, e->wb_wave_dma, &e->wb_command);
+	dma_wmb();
+	imx50_epdc_hw_wb_session(&e->hw, true);
+	imx50_epdc_hw_request_eof(&e->hw, true);
+	e->wb_active = true;
+	return epdc_wb_submit(e);
+}
+
 static void epdc_done_work(struct work_struct *work)
 {
 	struct imx50_epdc *e = container_of(to_delayed_work(work),
 					  struct imx50_epdc, done_work);
 
 	mutex_lock(&e->lock);
-	if (epdc_queue_idle(e) && READ_ONCE(e->hw.drained))
+	if (!e->wb_owner && epdc_queue_idle(e) && READ_ONCE(e->hw.drained))
 		epdc_off_locked(e);
 	mutex_unlock(&e->lock);
 }
@@ -596,6 +670,25 @@ static void epdc_submit_work(struct work_struct *work)
 		epdc_fail_queue(e, ev.error);
 		goto out;
 	}
+	if (e->wb_active) {
+		if (ev.wb)
+			e->wb_processing = false;
+		if ((ev.luts & 1) && !e->wb_stopping) {
+			ret = epdc_wb_submit(e);
+			if (ret) {
+				epdc_fail_queue(e, ret);
+				goto out;
+			}
+		}
+		wake_up_all(&e->hw.wb_wait);
+		if (!e->hw.wb_live && !e->wb_processing && READ_ONCE(e->hw.drained)) {
+			cancel_delayed_work(&e->watchdog);
+			wake_up_all(&e->idle_wait);
+			goto out;
+		}
+		deadline = e->wb_deadline;
+		goto watch;
+	}
 	epdc_events(e, &ev);
 	if (e->fault)
 		goto out;
@@ -615,7 +708,7 @@ static void epdc_submit_work(struct work_struct *work)
 	}
 	if (e->wb)
 		goto watch;
-	if (epdc_queue_idle(e)) {
+	if (epdc_queue_idle(e) && (!e->wb_owner || e->wb_stopping)) {
 		if (e->pixel_on && !READ_ONCE(e->hw.drained)) {
 			deadline = e->drain_deadline;
 			goto watch;
@@ -682,6 +775,13 @@ static void epdc_submit_work(struct work_struct *work)
 		deadline = e->init_deadline;
 		goto watch;
 	}
+	if (e->wb_owner && epdc_queue_idle(e) && !e->wb_stopping) {
+		ret = epdc_wb_prepare(e);
+		if (ret)
+			goto pending_error;
+		deadline = e->wb_deadline;
+		goto watch;
+	}
 	lut = imx50_epdc_hw_next_lut(&e->hw, &sync_eof);
 	if (lut == -EBUSY)
 		goto watch;
@@ -805,6 +905,8 @@ static void epdc_submit_work(struct work_struct *work)
 	goto watch;
 pending_error:
 	e->queue_error = ret;
+	if (e->wb_owner)
+		wake_up_all(&e->hw.wb_wait);
 	if (e->hw.fault) {
 		epdc_fail_queue(e, e->hw.fault);
 		goto out;
@@ -935,7 +1037,7 @@ int imx50_epdc_send_update(struct imx50_epdc *e,
 		list_add_tail(&m->update, &u->markers);
 	}
 	mutex_lock(&e->lock);
-	if (e->fault || e->stopped || e->suspended) {
+	if (e->fault || e->stopped || e->suspended || e->wb_owner) {
 		ret = e->fault ? e->fault : -EBUSY;
 		goto fail;
 	}
@@ -944,6 +1046,13 @@ int imx50_epdc_send_update(struct imx50_epdc *e,
 		if (ret)
 			goto fail;
 	}
+	if (e->restore_pending) {
+		/* Capture the entire canvas too: a partial SNAPSHOT cannot restore
+		 * unknown history after a WB session.
+		 */
+		u->data.region = (struct imx50_epdc_rect){ 0, 0, source->width, source->height };
+		u->data.update_mode = IMX50_EPDC_UPDATE_FULL;
+	}
 	if (e->scheme == IMX50_EPDC_SNAPSHOT) {
 		ret = epdc_capture(u);
 		if (ret)
@@ -1028,6 +1137,11 @@ int imx50_epdc_set_powerdown_delay(struct imx50_epdc *e, int delay)
 	if (delay < IMX50_EPDC_POWERDOWN_DISABLE)
 		return -EINVAL;
 	mutex_lock(&e->lock);
+	if (e->wb_owner) {
+		e->wb_saved_delay = delay;
+		mutex_unlock(&e->lock);
+		return 0;
+	}
 	e->powerdown_delay = delay;
 	cancel_delayed_work(&e->done_work);
 	if (delay != IMX50_EPDC_POWERDOWN_DISABLE && epdc_queue_idle(e) && e->pixel_on)
@@ -1076,6 +1190,258 @@ int imx50_epdc_powerdown(struct imx50_epdc *e)
 }
 EXPORT_SYMBOL_GPL(imx50_epdc_powerdown);
 
+/* The mapping uses its own anonymous inode, separate from the device fd.
+ * VMA references keep only this inode alive, so last fd release still STOPs.
+ * STOP zaps every PTE; remapped DMA has no fault handler and faults SIGBUS.
+ */
+static const struct file_operations epdc_wb_mapping_fops = {
+	.owner = THIS_MODULE,
+};
+
+static bool epdc_wb_started(struct imx50_epdc *e)
+{
+	bool done;
+
+	mutex_lock(&e->lock);
+	done = e->fault || e->queue_error || e->stopped || e->suspended ||
+		(e->wb_active && !e->wb_processing);
+	mutex_unlock(&e->lock);
+	return done;
+}
+
+static bool epdc_wb_drained(struct imx50_epdc *e)
+{
+	bool done;
+
+	mutex_lock(&e->lock);
+	done = e->fault || (!e->wb_processing && !READ_ONCE(e->hw.wb_live) &&
+		epdc_queue_idle(e) && (!e->pixel_on || READ_ONCE(e->hw.drained)));
+	mutex_unlock(&e->lock);
+	return done;
+}
+
+/* wb_lock held. Unmapping is outside owner lock: mmap takes that lock. */
+static int epdc_wb_stop(struct imx50_epdc *e)
+{
+	struct file *mapping;
+	long waited;
+	int ret;
+
+	mutex_lock(&e->lock);
+	if (!e->wb_owner) {
+		mutex_unlock(&e->lock);
+		return 0;
+	}
+	e->wb_stopping = true;
+	mapping = e->wb_mapping;
+	mutex_unlock(&e->lock);
+	if (mapping)
+		unmap_mapping_range(mapping->f_mapping, 0, 0, 1);
+	mutex_lock(&e->lock);
+	if (e->wb_active)
+		imx50_epdc_buffers_wb_hold(e->buffers);
+	epdc_notify(e);
+	mutex_unlock(&e->lock);
+	/* STOP and close must finish draining even if a signal is pending. */
+	waited = wait_event_timeout(e->idle_wait, epdc_wb_drained(e),
+				   msecs_to_jiffies(e->timeout_ms));
+	mutex_lock(&e->lock);
+	if (!waited && !e->fault)
+		epdc_fail_queue(e, -ETIMEDOUT);
+	ret = e->fault;
+	if (e->pixel_on && !e->fault)
+		imx50_epdc_hw_request_eof(&e->hw, false);
+	imx50_epdc_hw_wb_session(&e->hw, false);
+	e->restore_pending = true;
+	e->powerdown_delay = e->wb_saved_delay;
+	e->wb_owner = e->wb_mapping = NULL;
+	e->wb_active = e->wb_stopping = e->wb_processing = false;
+	epdc_notify(e);
+	mutex_unlock(&e->lock);
+	if (mapping)
+		fput(mapping);
+	return ret;
+}
+
+static int epdc_wb_start(struct imx50_epdc *e, struct file *file,
+	struct k4_epdc_wb_info *info)
+{
+	struct file *mapping;
+	long waited;
+	int ret;
+
+	mutex_lock(&e->lock);
+	ret = e->fault ?: (e->wb_owner || e->stopped || e->suspended ? -EBUSY : 0);
+	mutex_unlock(&e->lock);
+	if (ret)
